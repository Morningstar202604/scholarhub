# ScholarHUB — Environment Configuration
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# All values shown below are placeholders — replace them with real secrets.

# ─── Required ────────────────────────────────────────────────────────────────
# Secret key for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCHOLARHUB_SECRET_KEY=change-me-to-a-random-secret

# Bootstrap admin password (used on first run to create the admin user).
# Change this immediately after first login.
SCHOLARHUB_ADMIN_PASSWORD=change-me

# Database URL (PostgreSQL with asyncpg driver).
# Format: postgresql+asyncpg://user:password@host:port/database
SCHOLARHUB_DATABASE_URL=postgresql+asyncpg://scholarhub:change-me@localhost:5432/scholarhub

# ─── Optional ────────────────────────────────────────────────────────────────
# Meilisearch for full-text search. If omitted, falls back to DB ILIKE.
# SCHOLARHUB_MEILISEARCH_URL=http://localhost:7700
# SCHOLARHUB_MEILISEARCH_API_KEY=change-me

# Redis for rate-limit store and token denylist.
# If omitted, uses in-memory stores (not suitable for multi-node).
# SCHOLARHUB_REDIS_URL=redis://localhost:6379

# Environment: development | test | production
SCHOLARHUB_ENVIRONMENT=development

# CORS origins (comma-separated, no spaces around commas).
SCHOLARHUB_CORS_ORIGINS=http://localhost:5173

# Allowed hosts (comma-separated, no spaces).
SCHOLARHUB_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin bootstrap email and username (optional, defaults shown).
# SCHOLARHUB_ADMIN_EMAIL=admin@example.com
# SCHOLARHUB_ADMIN_USERNAME=admin

# Log level: DEBUG | INFO | WARNING | ERROR
SCHOLARHUB_LOG_LEVEL=INFO

# Set to "true" for structured JSON logs (production).
SCHOLARHUB_JSON_LOGS=false

# Storage backend: local | s3
SCHOLARHUB_STORAGE_BACKEND=local
SCHOLARHUB_STORAGE_PATH=/data/uploads

# Token expiration (minutes for access, days for refresh).
SCHOLARHUB_ACCESS_TOKEN_EXPIRE_MINUTES=15
SCHOLARHUB_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting TOTP secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCHOLARHUB_FERNET_KEY=change-me

# Rate limit — requests per minute per IP per route.
SCHOLARHUB_RATE_LIMIT_PER_MINUTE=120

# ─── S3 Storage (optional, requires SCHOLARHUB_STORAGE_BACKEND=s3) ────────────
# SCHOLARHUB_S3_BUCKET=scholarhub-uploads
# SCHOLARHUB_S3_REGION=us-east-1
# SCHOLARHUB_S3_ENDPOINT_URL=https://s3.amazonaws.com
# SCHOLARHUB_S3_ACCESS_KEY_ID=change-me
# SCHOLARHUB_S3_SECRET_ACCESS_KEY=change-me

# ─── OIDC / SSO (optional) ───────────────────────────────────────────────────
# SCHOLARHUB_OIDC_GOOGLE_CLIENT_ID=change-me
# SCHOLARHUB_OIDC_GOOGLE_CLIENT_SECRET=change-me
# SCHOLARHUB_OIDC_ORCID_CLIENT_ID=change-me
# SCHOLARHUB_OIDC_ORCID_CLIENT_SECRET=change-me

# ─── Email (optional, uses console backend by default in dev) ────────────────
# SCHOLARHUB_EMAIL_BACKEND=smtp
# SCHOLARHUB_EMAIL_SMTP_HOST=smtp.example.com
# SCHOLARHUB_EMAIL_SMTP_PORT=587
# SCHOLARHUB_EMAIL_SMTP_USER=change-me
# SCHOLARHUB_EMAIL_SMTP_PASSWORD=change-me
# SCHOLARHUB_EMAIL_FROM_ADDRESS=noreply@example.com

# ─── Sentry / Error Monitoring (optional) ────────────────────────────────────
# SCHOLARHUB_SENTRY_DSN=https://change-me@o0.ingest.sentry.io/0

# ─── Key Rotation ────────────────────────────────────────────────────────────
# Comma-separated list of previous secret keys for rotation.
# SCHOLARHUB_PREVIOUS_SECRET_KEYS=

# ─── DOI / DataCite (optional) ───────────────────────────────────────────────
# SCHOLARHUB_DATACITE_PREFIX=10.xxxxx
# SCHOLARHUB_DATACITE_USERNAME=change-me
# SCHOLARHUB_DATACITE_PASSWORD=change-me

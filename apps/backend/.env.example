# ScholarHUB backend environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All vars are prefixed SCHOLARHUB_ (case-insensitive).

# --- Application identity ---
SCHOLARHUB_APP_NAME=ScholarHUB API
SCHOLARHUB_ENVIRONMENT=development
# development | staging | production | test
SCHOLARHUB_DEBUG=false

# --- Tenancy ---
# single = one tenant per deployment (typical self-hosted)
# multi  = many tenants resolved from host header (SaaS)
SCHOLARHUB_TENANCY_MODE=single
SCHOLARHUB_BOOTSTRAP_TENANT_SLUG=default

# --- Database (PostgreSQL only — RLS requires PG) ---
# Example: postgresql+asyncpg://user:pass@localhost:5432/scholarhub
SCHOLARHUB_DATABASE_URL=postgresql+asyncpg://scholarhub:scholarhub@localhost:5432/scholarhub
SCHOLARHUB_DB_POOL_SIZE=10
SCHOLARHUB_DB_MAX_OVERFLOW=20
SCHOLARHUB_DB_POOL_RECYCLE=1800
SCHOLARHUB_DB_POOL_PRE_PING=true
SCHOLARHUB_DB_POOL_TIMEOUT=30
SCHOLARHUB_DB_STARTUP_RETRIES=5
SCHOLARHUB_DB_STARTUP_RETRY_DELAY=2.0

# --- Redis (cache + rate limit; empty = fail-open in-memory) ---
SCHOLARHUB_REDIS_URL=

# --- JWT / Auth ---
# Generate with: openssl rand -hex 32
SCHOLARHUB_SECRET_KEY=<generate-with-openssl-rand-hex-32>
SCHOLARHUB_ACCESS_TOKEN_EXPIRE_MINUTES=15
SCHOLARHUB_REFRESH_TOKEN_EXPIRE_DAYS=7
SCHOLARHUB_ALGORITHM=HS256
SCHOLARHUB_REFRESH_TOKEN_COOKIE_NAME=scholarhub_refresh
# Override auto-detection (production=True, else=False):
# SCHOLARHUB_REFRESH_TOKEN_COOKIE_SECURE=true
SCHOLARHUB_REFRESH_TOKEN_COOKIE_SAMESITE=strict

# --- CORS / Trusted hosts ---
SCHOLARHUB_CORS_ORIGINS=http://localhost:5173,http://localhost
SCHOLARHUB_ALLOWED_HOSTS=localhost,127.0.0.1
SCHOLARHUB_TRUSTED_PROXIES_COUNT=0

# --- Rate limiting ---
SCHOLARHUB_RATE_LIMIT_PER_MINUTE=120

# --- Logging ---
SCHOLARHUB_LOG_LEVEL=INFO
# JSON logs recommended in production
SCHOLARHUB_JSON_LOGS=false

# --- Error monitoring (Sentry, optional) ---
# 留空 = 不启用（SDK 完全不 import）。启用前先装依赖：
#   uv sync --extra monitoring
SCHOLARHUB_SENTRY_DSN=
# 性能追踪采样率 0~1
SCHOLARHUB_SENTRY_TRACES_SAMPLE_RATE=0.1
# 性能剖析采样率 0~1（0 = 关闭）
SCHOLARHUB_SENTRY_PROFILES_SAMPLE_RATE=0.0
# 是否上报 PII（IP/请求体等）。默认 false：投稿含未发表稿件与审稿人身份
SCHOLARHUB_SENTRY_SEND_DEFAULT_PII=false

# --- Admin bootstrap (first startup) ---
SCHOLARHUB_ADMIN_EMAIL=admin@scholarhub.local
SCHOLARHUB_ADMIN_USERNAME=admin
# At least 12 characters, not a common weak value
SCHOLARHUB_ADMIN_PASSWORD=<change-me-at-least-12-chars>

# --- Storage (Phase 10+) ---
SCHOLARHUB_STORAGE_BACKEND=local
SCHOLARHUB_STORAGE_PATH=/data/uploads

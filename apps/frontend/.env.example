# 后端 API base URL（开发默认走 vite proxy 也可，这里显式配置方便生产）
VITE_API_URL=http://localhost:8000/api

# OIDC SSO 开关：true 时登录页显示 "使用 SSO 登录" 按钮
VITE_OIDC_ENABLED=false
# OIDC provider 名（与 backend SCHOLARHUB_OIDC_PROVIDER 对应）
VITE_OIDC_PROVIDER=google

# Sentry 错误监控（可选）。留空 = 不启用，错误只打 console。
# 配置后前端会动态加载 @sentry/react 并上报未捕获异常与渲染错误。
VITE_SENTRY_DSN=
# 浏览器端性能追踪采样率（0~1，默认 0.1）
VITE_SENTRY_TRACES_RATE=0.1
